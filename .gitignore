mlx_env/
__pycache__/
*.pyc
.DS_Store
*.egg-info/

# large downloaded/converted model weights and checkpoints
models/*
!models/.gitkeep

# regenerable vector index (rebuild with: python scripts/rag.py index)
data/processed/chunk_embeddings.npz

# Scryfall bulk dumps (re-downloadable; derived chunks are tracked instead)
data/cards/raw/oracle_cards.jsonl
data/cards/raw/rulings.jsonl

# editor lock files (LibreOffice/OpenOffice on the intake templates)
.~lock.*#

# raw worksheet fetches — re-fetchable and redundant; the parsed
# scenarios.jsonl is the tracked artifact
data/judge_worksheets/raw/

# RulesGuru raw API responses — redundant with the frozen
# questions.jsonl snapshot, which is the tracked artifact
data/gold/rulesguru/raw/

# Local orientation doc — regenerate or edit freely; deliberately untracked so
# it never becomes another file that has to be kept in sync at review time.
REPO_MAP.md

# Rubric authoring round-trip. Both regenerable, neither needed publicly:
# tasks.json is rebuilt by `author_rubrics.py --export-tasks`, and the
# submissions log is an audit trail whose content lands in the gold set on
# import — where `rubric_source` already records who wrote each rubric.
data/gold/worksheets/tasks.json
data/submissions.jsonl
data/submissions.pre-migration.jsonl

# Local planning doc — deliberately not published (see REPO_MAP.md precedent)
PLAN_NEXT.md

# The deployed form writes this locally; verdicts are promoted into
# data/gold/judge_adjudications.jsonl by `adjudicate.py --ingest-submissions`,
# so the raw log is a working file and not a tracked artifact.
submissions.jsonl

# Chat ratings: user-submitted questions and free-text notes, appended by a
# long-running server. Ignored for the same reasons data/submissions.jsonl is
# — it is personal data written by people outside the project, and an
# append-only log would otherwise produce a diff on every single rating.
# Promotion into the gold set goes through review, never through git.
data/chat/

# Tilt writes one log file per service here. Runtime output, not source: it is
# what makes a restart diffable, and it must never be committed.
logs/
